        "name": "list_leads",
        "title": "Listar leads",
        "description": "Lista os leads do CRM visíveis para o usuário autenticado, com filtros opcionais por status, temperatura, unidade e busca por nome/empresa/email.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
