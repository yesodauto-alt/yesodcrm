          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Texto para buscar em nome, empresa ou email.",
              "type": "string"
            },
            "status": {
              "description": "Filtra pelo status do lead.",
              "type": "string",
              "enum": [
                "novo",
                "contato",
                "diagnostico",
                "proposta",
                "negociacao",
                "ganho",
                "perdido"
              ]
            },
            "temperatura": {
              "type": "string",
              "enum": [
                "frio",
                "morno",
                "quente"
              ]
            },
            "unidade": {
              "type": "string"
            },
            "limit": {
              "description": "Número máximo de leads (padrão 25, máx 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_lead",
